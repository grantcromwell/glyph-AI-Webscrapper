# systemd-networkd: give the USB-C ethernet gadget a fixed address so a laptop
# plugged into the Pi's USB-C port always finds the dog at 10.55.0.1.
# Install to /etc/systemd/network/usb0.network and `systemctl enable systemd-networkd`.
[Match]
Name=usb0

[Network]
Address=10.55.0.1/24
# Hand the laptop an address over the link so it needs no manual config.
DHCPServer=yes

[DHCPServer]
PoolOffset=10
PoolSize=20
EmitDNS=no
